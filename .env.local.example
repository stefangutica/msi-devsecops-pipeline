# Example .env file for DevSecOps pipeline
# Copy this to .env and fill in your values

# ============================================
# APPLICATION CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ============================================
# SECURITY SCANNING - GITHUB
# ============================================
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# ============================================
# SONARQUBE CONFIGURATION
# ============================================
# Self-hosted: http://your-sonarqube-server:9000
# Cloud: https://sonarcloud.io
SONAR_HOST_URL=http://localhost:9000
SONAR_LOGIN=admin
SONAR_PASSWORD=admin

# ============================================
# SNYK CONFIGURATION
# ============================================
# Get from: https://snyk.io/settings/api
SNYK_TOKEN=your_snyk_token_here
SNYK_ORG_ID=your_org_id

# ============================================
# VAULT SECRETS MANAGEMENT
# ============================================
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=myroot
VAULT_NAMESPACE=secret

# ============================================
# DATABASE CONFIGURATION (Example)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=secure_password
DB_NAME=msi_devsecops

# ============================================
# API KEYS & CREDENTIALS (Example)
# ============================================
# ⚠️  NEVER hardcode real secrets here!
# Use Vault or GitHub Secrets instead
API_KEY_EXAMPLE=your_api_key_here
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret

# ============================================
# SECURITY SETTINGS
# ============================================
SECURE_COOKIES=true
HTTP_ONLY_COOKIES=true
SAME_SITE=Strict
HELMET_CSP=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true
PROMETHEUS_METRICS_ENABLED=true
PROMETHEUS_PORT=9090

# ============================================
# DEVELOPMENT ONLY
# ============================================
# Set to false in production
DEBUG=false
DEVELOPMENT_MODE=false

# ============================================
# DOCKER CONFIGURATION
# ============================================
DOCKER_REGISTRY=docker.io
DOCKER_IMAGE_NAME=msi-devsecops
DOCKER_IMAGE_TAG=latest
